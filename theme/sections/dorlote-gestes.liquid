<section aria-labelledby="titre-{{ section.id }}">
  <div class="wrap">
    <h2 id="titre-{{ section.id }}">{{ section.settings.titre | escape }}</h2>
    <div class="gestes-grid">
      {%- for block in section.blocks -%}
        <div class="geste" {{ block.shopify_attributes }}>
          <div class="sch" aria-hidden="true">{%- case block.settings.schema -%}{%- when 'deux' -%}<i></i><i></i>{%- when 'long' -%}<i></i><b></b>{%- else -%}<i></i>{%- endcase -%}</div>
          <h3>{{ block.settings.titre | escape }}</h3><p>{{ block.settings.texte | escape }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gestes",
  "settings": [ { "type": "text", "id": "titre", "label": "Titre", "default": "Trois gestes, même à moitié endormi." } ],
  "blocks": [
    { "type": "geste", "name": "Geste", "settings": [
      { "type": "select", "id": "schema", "label": "Dessin", "options": [ { "value": "un", "label": "Un appui" }, { "value": "deux", "label": "Deux appuis" }, { "value": "long", "label": "Appui long" } ], "default": "un" },
      { "type": "text", "id": "titre", "label": "Titre", "default": "Un appui" },
      { "type": "textarea", "id": "texte", "label": "Texte", "default": "Allumer ou éteindre." }
    ] }
  ],
  "max_blocks": 3,
  "presets": [{ "name": "Gestes", "blocks": [
    { "type": "geste", "settings": { "schema": "un", "titre": "Un appui", "texte": "Allumer ou éteindre, sans chercher d'interrupteur dans le noir." } },
    { "type": "geste", "settings": { "schema": "deux", "titre": "Deux appuis", "texte": "Passer de la lumière chaude à la neutre, puis à la froide." } },
    { "type": "geste", "settings": { "schema": "long", "titre": "Appui long", "texte": "Monter ou baisser l'intensité, jusqu'à une lueur de veilleuse." } }
  ] }]
}
{% endschema %}
