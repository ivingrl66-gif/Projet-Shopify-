<header class="top">
  <div class="wrap">
    <a class="logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}, accueil">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: alt: shop.name, height: 40, loading: 'eager' }}
      {%- else -%}
        <span class="logo-texte">{{ shop.name }}</span>
      {%- endif -%}
    </a>
    <nav aria-label="Navigation principale">
      {%- for block in section.blocks -%}
        <a {% if block.settings.masquer_mobile %}class="hide-sm" {% endif %}href="{{ block.settings.lien | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.libelle | escape }}</a>
      {%- endfor -%}
      <button class="cart-btn" id="open-cart" type="button" aria-label="Ouvrir le panier">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 11.1a2 2 0 0 1-2 1.9H8.2a2 2 0 0 1-2-1.9L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
        Panier <span class="cart-count" id="cart-count" aria-live="polite">{{ cart.item_count }}</span>
      </button>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "En-tête Maison Dorlote",
  "blocks": [
    {
      "type": "lien",
      "name": "Lien",
      "settings": [
        { "type": "text", "id": "libelle", "label": "Libellé", "default": "FAQ" },
        { "type": "text", "id": "lien", "label": "Lien (ex. #faq ou /pages/contact)", "default": "#faq" },
        { "type": "checkbox", "id": "masquer_mobile", "label": "Masquer sur mobile", "default": false }
      ]
    }
  ],
  "max_blocks": 4,
  "default": {
    "blocks": [
      { "type": "lien", "settings": { "libelle": "La lampe", "lien": "#lampe", "masquer_mobile": true } },
      { "type": "lien", "settings": { "libelle": "Avant / après", "lien": "#avant-apres", "masquer_mobile": true } },
      { "type": "lien", "settings": { "libelle": "FAQ", "lien": "#faq" } }
    ]
  }
}
{% endschema %}
