{%- comment -%}Styles Maison Dorlote, repris de la maquette validée (maquette/index.html).{%- endcomment -%}
<style>

/* Layout: une seule colonne qui descend du jour vers la nuit. Hero nocturne, bloc d'achat immédiatement dessous, puis preuves (avant/après, teintes, gestes), puis réassurance claire (FAQ sur fond lin). */
:root{
  --nuit:#1E1A17;
  --nuit-2:#2B2420;
  --nuit-3:#3a312b;
  --ambre:#E8A55B;
  --ambre-fonce:#c9853d;
  --miel:#F4D6A8;
  --lin:#F6EFE6;
  --lin-2:#ECE2D5;
  --gris:#8C8178;
  --gris-clair:#b8ada3;
  --encre:#1E1A17;
  --display:"Fraunces", "Iowan Old Style", Georgia, serif;
  --texte:"Figtree", system-ui, -apple-system, "Segoe UI", sans-serif;
  --r:14px;
  --max:1180px;
  color-scheme:dark;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{animation:none!important;transition:none!important}}
body{margin:0;background:var(--nuit);color:var(--lin);font-family:var(--texte);font-size:17px;line-height:1.55}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:60;background:var(--nuit)}
img{max-width:100%;display:block}
a{color:inherit}
button{font:inherit;color:inherit;cursor:pointer}
:focus-visible{outline:2px solid var(--ambre);outline-offset:3px;border-radius:6px}
h1,h2,h3{font-family:var(--display);font-variation-settings:"SOFT" 100;font-weight:400;line-height:1.1;margin:0;text-wrap:balance;letter-spacing:-.01em}
h2{font-size:clamp(30px,4.6vw,48px)}
h3{font-size:22px}
p{margin:0}
.wrap{max-width:var(--max);margin-inline:auto;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.tbd{background:rgba(232,165,91,.14);border:1px dashed rgba(232,165,91,.7);border-radius:5px;padding:0 5px;color:var(--miel);font-style:normal;white-space:nowrap}
.light .tbd{background:#f1dcc0;border-color:#b77a39;color:#6b4517}
section{padding-block:clamp(64px,9vw,120px)}

/* Logo */
.logo{display:inline-flex;align-items:center;text-decoration:none;line-height:0}
.logo svg{height:40px;width:auto}
.logo circle{animation:respire 5s cubic-bezier(.45,0,.55,1) infinite;transform-origin:32px 40px;transform-box:view-box}
@keyframes respire{0%,100%{opacity:.8}50%{opacity:1}}
::selection{background:var(--ambre);color:var(--encre)}
html{scrollbar-color:var(--nuit-3) var(--nuit);caret-color:var(--ambre);accent-color:var(--ambre)}

/* Barre d'annonce + en-tête */
.annonce{background:var(--nuit-2);color:var(--miel);font-size:14px;text-align:center;padding-block:9px}
.annonce .wrap{display:flex;gap:18px;justify-content:center;flex-wrap:wrap}
.maquette{background:#4a3a2c;color:var(--miel);font-size:12.5px;text-align:center;padding-block:6px}
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:var(--nuit);border-bottom:1px solid rgba(246,239,230,.07)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
header nav{display:flex;align-items:center;gap:22px;font-size:15px}
header nav a{text-decoration:none;color:var(--gris-clair)}
header nav a:hover{color:var(--lin)}
.cart-btn{background:none;border:1px solid rgba(246,239,230,.18);border-radius:999px;padding:7px 14px;display:inline-flex;gap:8px;align-items:center;font-size:15px}
.cart-btn:hover{border-color:var(--ambre)}
.cart-count{background:var(--ambre);color:var(--encre);border-radius:999px;min-width:22px;height:22px;display:inline-grid;place-items:center;font-size:13px;font-weight:600;padding-inline:6px}
@media (max-width:640px){header nav .hide-sm{display:none}}

/* Hero */
.hero{position:relative;min-height:min(85vh,760px);display:flex;align-items:center;overflow:hidden;padding-block:0}
.hero picture,.hero picture img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.hero picture img{object-position:70% 50%;animation:allumage 2.4s ease-out both}
@keyframes allumage{from{filter:brightness(.55)}to{filter:brightness(1)}}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,26,23,.92) 0%,rgba(30,26,23,.7) 38%,rgba(30,26,23,0) 70%)}
.hero .wrap{position:relative;z-index:1;width:100%;padding-block:72px}
.hero-txt{max-width:560px;display:grid;gap:22px}
.hero h1{font-size:clamp(40px,6.4vw,76px);font-weight:300}
.hero h1 em{font-style:italic;color:var(--miel)}
.hero p.sub{font-size:clamp(17px,1.6vw,20px);color:#e6dccf;max-width:470px}
.hero .ctas{display:flex;gap:14px;flex-wrap:wrap;align-items:center}
.hero .micro{font-size:14px;color:var(--gris-clair);display:flex;gap:16px;flex-wrap:wrap}
@media (max-width:760px){
  .hero{min-height:auto;display:block}
  .hero picture{position:relative;display:block;aspect-ratio:4/5;max-height:68vh;width:100%}
  .hero picture img{object-position:30% 62%}
  .hero::after{inset:auto 0 0 0;height:100%;background:linear-gradient(180deg,rgba(30,26,23,0) 0%,rgba(30,26,23,0) 64%,var(--nuit) 70%)}
  .hero .wrap{margin-top:-28px;padding-top:0;padding-bottom:44px}
}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:999px;padding:15px 26px;font-weight:600;font-size:16.5px;text-decoration:none;border:0;transition:transform .2s,background .2s,box-shadow .3s}
.btn-ambre{background:var(--ambre);color:var(--encre)}
.btn-ambre:hover{background:#f0b571;box-shadow:0 8px 24px -8px rgba(232,165,91,.55)}
.btn-ambre:active{transform:scale(.98)}
.btn-ligne{background:transparent;border:1px solid rgba(246,239,230,.3);color:var(--lin)}
.btn-ligne:hover{border-color:var(--miel)}

/* Bloc d'achat */
.achat{padding-top:clamp(40px,6vw,80px);background:linear-gradient(180deg,var(--nuit) 0%,var(--nuit-2) 100%)}
.achat-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:clamp(28px,5vw,64px);align-items:start}
@media (max-width:900px){.achat-grid{grid-template-columns:1fr}}
.galerie{display:grid;gap:12px;min-width:0}
.galerie .main{border-radius:var(--r);overflow:hidden;background:var(--nuit-3);aspect-ratio:4/5;max-width:100%}
.galerie .main img{width:100%;height:100%;object-fit:cover;transition:opacity .35s}
.thumbs{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.thumbs button{padding:0;border:1px solid transparent;border-radius:10px;overflow:hidden;background:none;aspect-ratio:1;opacity:.6;transition:opacity .2s,border-color .2s}
.thumbs button[aria-current="true"]{opacity:1;border-color:var(--ambre)}
.thumbs img{width:100%;height:100%;object-fit:cover}
@media (max-width:900px){
  .galerie .main{display:none}
  .thumbs{grid-template-columns:none;grid-auto-flow:column;grid-auto-columns:84%;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;scrollbar-width:none}
  .thumbs::-webkit-scrollbar{display:none}
  .thumbs button{aspect-ratio:4/5;opacity:1;scroll-snap-align:start;border:0;border-radius:var(--r)}
}
.fiche{display:grid;gap:22px;min-width:0;position:sticky;top:96px}
@media (max-width:900px){.fiche{position:static}}
.fiche h1{font-size:clamp(32px,3.6vw,42px)}
.fiche .accroche{color:#ddd2c4}
.prix{display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.prix .p{font-family:var(--display);font-size:34px;font-variant-numeric:tabular-nums}
.prix .note{font-size:14px;color:var(--gris-clair)}
.offres{display:grid;gap:10px;border:0;padding:0;margin:0}
.offres legend{font-size:14px;color:var(--gris-clair);margin-bottom:8px;padding:0}
.offre{display:grid;grid-template-columns:auto 1fr auto;gap:14px;align-items:center;border:1px solid rgba(246,239,230,.14);border-radius:12px;padding:14px 16px;cursor:pointer;transition:border-color .2s,background .2s}
.offre:has(input:checked){border-color:var(--ambre);background:rgba(232,165,91,.07)}
.offre input{accent-color:var(--ambre);width:18px;height:18px;margin:0}
.offre .t{font-weight:600}
.offre .s{font-size:14px;color:var(--gris-clair)}
.offre .v{font-variant-numeric:tabular-nums;font-weight:600;text-align:right}
.offre .badge{display:inline-block;margin-left:8px;font-size:12px;background:var(--ambre);color:var(--encre);border-radius:999px;padding:2px 8px;font-weight:600;vertical-align:2px}
.points{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.points li{display:grid;grid-template-columns:22px 1fr;gap:10px;align-items:start;color:#e6dccf}
.points li::before{content:"";width:10px;height:10px;margin:7px 0 0 4px;border-radius:50%;background:radial-gradient(circle,var(--miel) 0 30%,rgba(232,165,91,.35) 60%,transparent 72%)}
.add{width:100%;padding-block:18px;font-size:17.5px}
.actions{display:grid;gap:10px}
.btn-express{width:100%;background:var(--lin);color:var(--encre);padding-block:14px;display:flex;flex-direction:column;gap:3px;line-height:1.35}
.btn-express:hover{background:#fff}

.dispo{display:flex;align-items:flex-start;gap:9px;font-size:15px;color:#e6dccf;margin-top:-6px}
.dispo strong{color:var(--lin);font-weight:600}
.pastille-stock{flex:none;margin-top:7px;width:9px;height:9px;border-radius:50%;background:#7fbf7a;box-shadow:0 2px 6px -1px rgba(127,191,122,.6)}
.reassure{display:grid;grid-template-columns:1fr 1fr;gap:12px 18px;font-size:14px;color:var(--gris-clair)}
.reassure div{display:flex;gap:9px;align-items:flex-start}
.reassure svg{flex:none;margin-top:2px;stroke:var(--ambre)}
.pi{height:24px;width:auto;border-radius:4px;display:block}
.pi-row{display:flex;flex-wrap:wrap;gap:6px;align-items:center}
.paiement{margin-top:2px}
.express-logos{display:flex;gap:6px;justify-content:center;margin-top:4px}
.express-logos .pi{height:22px}
.pied-paie{display:grid;gap:8px}
.pied-paie .pi{height:22px}

/* Avant / après */
.compare h2{max-width:720px}
.compare .lead{color:#ddd2c4;max-width:620px;margin-top:16px}
.ba{position:relative;margin-top:40px;border-radius:var(--r);overflow:hidden;aspect-ratio:16/9;max-width:100%;user-select:none;-webkit-user-select:none;touch-action:pan-y;background:var(--nuit-3)}
.ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.ba .apres{clip-path:inset(0 0 0 var(--pos,50%))}
.ba .ligne{position:absolute;top:0;bottom:0;left:var(--pos,50%);width:2px;background:var(--miel);transform:translateX(-1px);pointer-events:none;box-shadow:0 0 18px rgba(232,165,91,.8)}
.ba .poignee{position:absolute;top:50%;left:var(--pos,50%);width:52px;height:52px;border-radius:50%;transform:translate(-50%,-50%);background:var(--nuit);border:2px solid var(--miel);display:grid;place-items:center;pointer-events:none;box-shadow:0 0 30px rgba(232,165,91,.5)}
.ba input[type=range]{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
.ba .tag{position:absolute;bottom:14px;font-size:13px;font-weight:600;letter-spacing:.04em;padding:6px 12px;border-radius:999px;pointer-events:none}
.ba .tag.l{left:14px;background:rgba(255,255,255,.85);color:#333}
.ba .tag.r{right:14px;background:rgba(30,26,23,.8);color:var(--miel)}
@media (max-width:640px){.ba{aspect-ratio:4/3}}
.legende{font-size:13px;color:var(--gris-clair);margin-top:12px}
.compare-pts{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:44px}
@media (max-width:760px){.compare-pts{grid-template-columns:1fr;gap:20px}}
.compare-pts h3{font-size:20px;margin-bottom:6px;color:var(--miel)}
.compare-pts p{color:#d8cdbf;font-size:16px}

/* Teintes */
.teintes{background:var(--nuit-2)}
.teintes-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,5vw,72px);align-items:center}
@media (max-width:860px){.teintes-grid{grid-template-columns:1fr}}
.teinte-img{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:4/5;max-width:100%;background:var(--nuit-3)}
.teinte-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transition:opacity .6s}
.teinte-img img.on{opacity:1}
.teinte-txt{display:grid;gap:22px}
.choix{display:grid;gap:10px}
.choix button{display:grid;grid-template-columns:28px 1fr;gap:14px;align-items:center;text-align:left;background:none;border:1px solid rgba(246,239,230,.14);border-radius:12px;padding:14px 16px;transition:border-color .2s,background .2s}
.choix button[aria-pressed="true"]{border-color:var(--ambre);background:rgba(232,165,91,.07)}
.choix .pastille{width:26px;height:26px;border-radius:50%}
.choix .t{font-weight:600;display:block}
.choix .s{font-size:14px;color:var(--gris-clair)}

/* Gestes */
.gestes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
@media (max-width:760px){.gestes-grid{grid-template-columns:1fr}}
.geste{border-top:1px solid rgba(246,239,230,.14);padding-top:22px;display:grid;gap:10px}
.geste .sch{display:flex;gap:6px;height:28px;align-items:center}
.geste .sch i{width:16px;height:16px;border-radius:50%;background:radial-gradient(circle,var(--miel) 0 30%,rgba(232,165,91,.4) 60%,transparent 72%)}
.geste .sch b{height:8px;width:72px;border-radius:999px;background:linear-gradient(90deg,rgba(232,165,91,.15),var(--ambre))}
.geste h3{color:var(--lin)}
.geste p{color:#d8cdbf;font-size:16px}

/* Usages */
.usages{background:linear-gradient(180deg,var(--nuit) 0%,var(--nuit-2) 100%)}
.usages-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:44px}
@media (max-width:860px){.usages-grid{grid-template-columns:1fr}}
.usage{display:grid;gap:14px}
.usage .img{border-radius:var(--r);overflow:hidden;aspect-ratio:4/5;max-width:100%}
.usage .img img{width:100%;height:100%;object-fit:cover;transition:transform .8s}
.usage:hover .img img{transform:scale(1.03)}
.usage .heure{font-family:var(--display);color:var(--ambre);font-size:15px;font-variant-numeric:tabular-nums;letter-spacing:.04em}
.usage p{color:#d8cdbf;font-size:16px}

/* Sections claires */
.light{background:var(--lin);color:var(--encre)}
.specs-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(28px,5vw,72px);align-items:start}
@media (max-width:860px){.specs-grid{grid-template-columns:1fr}}
.specs-grid > div{min-width:0}
dl.specs{margin:0;display:grid;grid-template-columns:minmax(120px,38%) 1fr;border-top:1px solid #dccfbf}
dl.specs dt,dl.specs dd{margin:0;padding:14px 0;border-bottom:1px solid #dccfbf;font-size:16px}
dl.specs dt{color:#6f645a}
dl.specs dd{font-weight:500}
.boite{margin-top:26px;background:var(--lin-2);border-radius:var(--r);padding:20px 22px;font-size:15.5px;color:#4a4038;display:grid;gap:6px}
.boite strong{color:var(--encre)}

.faq-grid{display:grid;grid-template-columns:1fr 1.6fr;gap:clamp(28px,5vw,72px);align-items:start}
@media (max-width:860px){.faq-grid{grid-template-columns:1fr}}
.faq-grid > div{min-width:0}
.faq-intro p{color:#5b5048;margin-top:16px}
.faq details{border-bottom:1px solid #dccfbf}
.faq details:first-child{border-top:1px solid #dccfbf}
.faq summary{list-style:none;cursor:pointer;padding:20px 40px 20px 0;font-weight:600;font-size:17px;position:relative}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"";position:absolute;right:6px;top:50%;width:12px;height:12px;border-right:2px solid #9a5f22;border-bottom:2px solid #9a5f22;transform:translateY(-70%) rotate(45deg);transition:transform .25s}
.faq details[open] summary::after{transform:translateY(-30%) rotate(-135deg)}
.faq .rep{padding:0 0 22px;color:#4a4038;display:grid;gap:10px;max-width:640px}

.garanties{background:var(--lin-2);color:var(--encre);padding-block:56px}
.garanties .g{display:grid;grid-template-columns:repeat(4,1fr);gap:28px}
@media (max-width:860px){.garanties .g{grid-template-columns:1fr 1fr}}
@media (max-width:480px){.garanties .g{grid-template-columns:1fr}}
.garanties h3{font-size:19px;margin-bottom:6px}
.garanties p{font-size:15px;color:#5b5048}

/* Cadeau (bloc d'achat) */
.cadeau-note{display:flex;gap:10px;align-items:flex-start;font-size:14.5px;color:#e6dccf;background:rgba(244,214,168,.06);border:1px solid rgba(244,214,168,.16);border-radius:12px;padding:12px 14px}
.cadeau-note svg{flex:none;margin-top:2px;stroke:var(--miel)}
.cadeau-note strong{color:var(--miel);font-weight:600}

/* Sécurité */
.secu{background:var(--nuit-2)}
.secu-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(20px,3vw,40px);margin-top:44px}
@media (max-width:900px){.secu-grid{grid-template-columns:1fr 1fr}}
@media (max-width:520px){.secu-grid{grid-template-columns:1fr}}
.secu-item{display:grid;gap:10px;align-content:start}
.secu-item svg{stroke:var(--miel)}
.secu-item h3{font-size:20px}
.secu-item p{color:#d8cdbf;font-size:16px}
.secu .note{margin-top:32px;font-size:14px;color:var(--gris-clair);max-width:70ch}

/* Comparatif */
.comparatif .lead{color:#4a4038;margin-top:14px;max-width:60ch}
.table-wrap{margin-top:36px;overflow-x:auto;-webkit-overflow-scrolling:touch}
table.cmp{width:100%;border-collapse:collapse;font-size:15.5px}
@media (max-width:640px){
  .cmp,.cmp thead,.cmp tbody{display:block}
  .cmp tr{display:grid;grid-template-columns:repeat(3,1fr)}
  .cmp th,.cmp td{display:block}
  .cmp thead td{display:none}
  .cmp thead th{font-size:15.5px;padding:12px 4px}
  .cmp tbody th[scope=row]{grid-column:1/-1;width:auto;border-bottom:0;padding:16px 4px 6px;font-size:14.5px;font-weight:600}
  .cmp td{padding:6px 4px 14px}
  .cmp tbody .nous{border-radius:0}
  .cmp .txt{font-size:13px}
}
.cmp th,.cmp td{padding:15px 14px;text-align:center;border-bottom:1px solid #dccfbf}
.cmp th[scope=row]{text-align:left;font-weight:500;color:#3b322b;width:38%}
.cmp thead th{font-family:var(--display);font-weight:400;font-size:18px;color:#3b322b;vertical-align:bottom}
.cmp .nous{background:#efe3d3}
.cmp thead .nous{border-radius:12px 12px 0 0;color:var(--encre)}
.cmp tbody tr:last-child .nous{border-radius:0 0 12px 12px}
.cmp svg{display:inline-block;vertical-align:middle}
@media (max-width:640px){.hide-xs{display:none}}
.cmp .non{stroke:#b3a596}
.cmp .oui{stroke:#9a5f22}
.cmp .txt{font-size:14px;color:#6f645a}

/* Avis */
.avis{background:var(--lin-2);color:var(--encre);padding-block:56px}
.avis .wrap{display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}
@media (max-width:760px){.avis .wrap{grid-template-columns:1fr}}
.avis h2{font-size:clamp(26px,3.4vw,34px)}
.avis p{color:#4a4038;margin-top:10px;max-width:60ch}
.avis .etoiles{display:flex;gap:4px}
.avis .etoiles svg{fill:none;stroke:#b3a596}

/* FAQ : filtres */
.faq-filtres{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.faq-filtres button{border:1px solid #d4c6b5;background:#fff;border-radius:999px;padding:8px 14px;font-size:14.5px;color:#3b322b;transition:background .2s,border-color .2s}
.faq-filtres button:hover{border-color:#9a5f22}
.faq-filtres button[aria-pressed="true"]{background:var(--encre);border-color:var(--encre);color:var(--lin)}

/* Panier : cadeau */
.cadeau-panier{margin-top:18px;border:1px solid #d4c6b5;border-radius:12px;padding:14px;background:#fbf7f2;display:grid;gap:10px}
.cadeau-panier label.chk{display:grid;grid-template-columns:20px 1fr;gap:10px;align-items:start;cursor:pointer}
.cadeau-panier .t{font-weight:600;font-size:15px}
.cadeau-panier .s{font-size:13px;color:#6f645a}
.cadeau-panier textarea{width:100%;font:inherit;font-size:15px;border:1px solid #d4c6b5;border-radius:10px;padding:10px 12px;min-height:80px;resize:vertical;background:#fff;color:var(--encre)}
